.godot/
build/
/apps/game/android/
.DS_Store

# Local acceptance notes and one-off capture scripts
/docs/verification.md
/apps/game/tests/capture.gd
/apps/game/tests/capture.gd.uid
/.local/

# Generated local agent setup
/.agents/

# Reproducible offline model exchange outputs (runtime uses TSCN)
/apps/game/assets/campuses/*/models/*.glb
/apps/game/assets/campuses/*/models/*.glb.import
/apps/game/assets/campuses/*/models/*_albedo.png
/apps/game/assets/campuses/*/models/*_albedo.png.import
/apps/game/assets/campuses/*/models/*_dut_emblem.png
/apps/game/assets/campuses/*/models/*_dut_emblem.png.import

# Blender-owned development-campus buildings. Commit .blend and runtime GLB;
# ignore Blender backups and temporary images extracted during migration/import.
/references/eda/buildings/blender/*.blend1
/apps/game/assets/campuses/eda/models/buildings/*.glb.import
/apps/game/assets/campuses/eda/models/buildings/*.png
/apps/game/assets/campuses/eda/models/buildings/*.png.import
/apps/game/assets/campuses/eda/models/development_campus.new.tscn
/apps/game/assets/campuses/eda/models/development_campus.bak.tscn

# Python caches
__pycache__/
*.pyc

# Website dependencies and generated embedded assets
/apps/web/node_modules/
/apps/web/dist/
/apps/api/static/
/apps/api/pb_data/
